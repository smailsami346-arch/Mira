# Comma-separated list of Solana RPC endpoints (fallback order = list order).
# Keys are NEVER exposed to the frontend; all RPC calls go through the backend proxy.
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com
# Single-endpoint shorthand (used if SOLANA_RPC_URLS is unset)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# PostgreSQL (Neon/Supabase) — used when the Prisma repository is enabled
DATABASE_URL=postgresql://user:pass@host:5432/db

# Redis (Upstash) — used for rate limiting / cache in production
REDIS_URL=redis://default:pass@host:6379
